# 智忆 Web 生产环境
ENV=production

NUXT_PUBLIC_GONLINE_WEB_ORIGIN=https://www.example.com

# 跨子域 SSO：与 gonline-ssr NUXT_PUBLIC_COOKIE_DOMAIN 保持一致
NUXT_PUBLIC_COOKIE_DOMAIN=.example.com

# SSR Nitro 同源 /gonline-api 代理目标：部署机 Java（无 /gonline-api 前缀）。须用宿主机/内网 IP，勿用 127.0.0.1（Node 在容器内时回环指容器自身会 502）。
NUXT_GONLINE_API_SERVER_TARGET=http://127.0.0.1:3922
