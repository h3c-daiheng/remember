# 复制为 .env.development 并按需修改（仓库已内置各环境 .env.*，一般无需复制）

# ---------- 本地开发（与 chat2x / gonline-ssr 一致）----------
# 1. 在 /etc/hosts 追加（见 hosts.example）：
#    127.0.0.1 zhiyi.local.example.com
#    127.0.0.1 gonline.local.example.com
# 2. 访问 http://zhiyi.local.example.com:4301（勿用 localhost:4301，否则 Cookie 无法共享）
# 3. 确保 gonline-ssr .env.development 中 NUXT_PUBLIC_COOKIE_DOMAIN=.local.example.com

ENV=development
NUXT_PUBLIC_GONLINE_WEB_ORIGIN=http://gonline.local.example.com:3905
NUXT_PUBLIC_COOKIE_DOMAIN=.local.example.com
# SSR 经 Nitro server/routes/gonline-api 转发到 gonline（无 /gonline-api 前缀；容器/多机勿用不可达的 127.0.0.1）
NUXT_GONLINE_API_SERVER_TARGET=http://gonline.local.example.com:3902
