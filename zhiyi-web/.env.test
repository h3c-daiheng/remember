# 智忆 Web 测试环境（hosts：zhiyi.test.example.com:4311）
ENV=test

NUXT_PUBLIC_GONLINE_WEB_ORIGIN=http://gonline.test.example.com:3913

# 跨子域 SSO：与 gonline-ssr 测试环境保持一致
NUXT_PUBLIC_COOKIE_DOMAIN=.test.example.com

# SSR Nitro 同源 /gonline-api 代理目标：部署机/内网 gonline（无 /gonline-api 前缀），勿用 127.0.0.1
NUXT_GONLINE_API_SERVER_TARGET=http://127.0.0.1:3912
