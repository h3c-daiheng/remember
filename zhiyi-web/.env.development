# 智忆 Web 本地开发环境（hosts 联调：zhiyi.local.example.com:4301）
ENV=development

# 巨人肩膀 portal 登录页 origin（须 NUXT_PUBLIC_ 前缀，Nuxt 才会注入到客户端 runtimeConfig）
NUXT_PUBLIC_GONLINE_WEB_ORIGIN=http://gonline.local.example.com:3905

# 跨子域 SSO：与 gonline-ssr NUXT_PUBLIC_COOKIE_DOMAIN 保持一致
NUXT_PUBLIC_COOKIE_DOMAIN=.local.example.com

# SSR Nitro 同源 /gonline-api 代理目标：gonline Java（无 /gonline-api 前缀）
NUXT_GONLINE_API_SERVER_TARGET=http://gonline.local.example.com:3902
