# =============================================================================
# 智忆环境变量示例
# 复制为 .env 并按需填写：  cp .env.example .env
# 首启也可用 docker/init-env.sh 自动生成随机密钥（仅 OPENAI_* 需手动填）
# =============================================================================

# ---- MySQL ----
# root 密码，首次启动前请改为随机值：openssl rand -hex 16
MYSQL_ROOT_PASSWORD=please-change-to-random-hex

# ---- 鉴权 ----
# JWT 签名密钥，长度须 >=32，部署前换成随机值：openssl rand -hex 32
JWT_SECRET=please-change-to-random-hex-at-least-32-chars

# ---- AI 网关 / 模型 ----
# ai-gateway 与 zhiyi-server 共享的 App Token，随机值：openssl rand -hex 16
MODEL_GATEWAY_APP_TOKEN=please-change-to-random-hex
# OpenAI 兼容 API（留空则 AI 召回/抽取功能不可用，其余功能正常）
OPENAI_API_BASE=https://ark.cn-beijing.volces.com/api/coding/v3
OPENAI_API_KEY=sk-替换为你的key
OPENAI_CHAT_MODEL=glm-5.2
# embedding 务必用文本模型，勿用 vision 模型，否则召回质量差
OPENAI_EMBEDDING_MODEL=doubao-embedding-text
